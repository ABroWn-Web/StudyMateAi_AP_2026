<%- include('partials/header', { title: 'Scoresheet' }) %>
<% const names = { '1-0': 'White wins', '0-1': 'Black wins', '1/2-1/2': 'Draw' }; %>
<div class="card hero">
  <div class="versus">
    <div class="side"><div class="muted">♔ White</div><div class="big">@<%= white.username %></div>
      <div><%= white.rating_before %> <b><%= white.rating_change >= 0 ? '+' : '' %><%= white.rating_change %></b></div></div>
    <div class="side"><div class="big" style="font-size:44px"><%= whiteScore %> – <%= blackScore %></div>
      <div><b><%= names[white.result] %></b> · <%= white.termination.toLowerCase() %></div>
      <div class="muted small"><%= white.base_seconds / 60 %>+<%= white.increment_seconds %> clock</div></div>
    <div class="side"><div class="muted">♚ Black</div><div class="big">@<%= black.username %></div>
      <div><%= black.rating_before %> <b><%= black.rating_change >= 0 ? '+' : '' %><%= black.rating_change %></b></div></div>
  </div>
</div>
<div class="card" style="margin-top:18px">
  <h2>Scoresheet</h2>
  <table>
    <tr><th>Move</th><th>Question</th><th>White</th><th>Black</th></tr>
    <% moves.forEach((m) => { %>
      <tr>
        <td class="rank"><%= m.position %></td>
        <td><%= m.question_text %></td>
        <td><span class="badge badge-<%= m.white_ok ? 'win' : 'loss' %>"><%= m.white_ok ? '✓' : '✗' %></span>
            <span class="small muted"><%= m.white_ms ? (m.white_ms / 1000).toFixed(1) + 's' : '' %></span></td>
        <td><span class="badge badge-<%= m.black_ok ? 'win' : 'loss' %>"><%= m.black_ok ? '✓' : '✗' %></span>
            <span class="small muted"><%= m.black_ms ? (m.black_ms / 1000).toFixed(1) + 's' : '' %></span></td>
      </tr>
    <% }) %>
  </table>
  <p><a class="btn" href="/duels?subject=<%= white.subject_id %>">← Back to duels</a></p>
</div>
<%- include('partials/footer') %>
