<%- include('partials/header', { title: 'Duels' }) %>
<div class="page-head">
  <div><h1>Duels</h1><p class="muted">Same quiz, two players, one chess clock. You play White.</p></div>
</div>
<%- include('partials/tabs') %>
<div class="card" style="margin-bottom:18px">
  <h2>Quick pairing</h2>
  <p class="muted small" style="margin-top:-8px">Pick a time control and you are paired with the closest-rated rival in this subject.</p>
  <div class="pairing">
    <% [['bullet', '1+0', 'Bullet'], ['blitz', '3+2', 'Blitz'], ['rapid', '10+0', 'Rapid']].forEach(([key, tc, name]) => { %>
      <form method="POST" action="/duels/quick">
        <input type="hidden" name="subject" value="<%= subject %>">
        <input type="hidden" name="clock" value="<%= key %>">
        <button><b><%= tc %></b><span><%= name %></span></button>
      </form>
    <% }) %>
  </div>
</div>
<div class="grid grid-2">
  <div class="card">
    <h2>Challenge a rival</h2>
    <table>
      <tr><th>Player</th><th>Rating</th><th>Clock</th><th></th></tr>
      <% rivals.forEach((r) => { %>
        <tr>
          <td><b><% if (r.title_code !== 'CLUB') { %><span class="title-tag"><%= r.title_code %></span><% } %>@<%= r.username %></b><div class="small muted">±<%= r.gap %></div></td>
          <td><%= r.rating %></td>
          <td colspan="2">
            <form method="POST" action="/duels/challenge" style="display:flex;gap:6px">
              <input type="hidden" name="subject" value="<%= subject %>">
              <input type="hidden" name="rival_id" value="<%= r.user_id %>">
              <select name="clock" style="width:auto;padding:6px 8px">
                <option value="bullet">Bullet 1+0</option>
                <option value="blitz" selected>Blitz 3+2</option>
                <option value="rapid">Rapid 10+0</option>
              </select>
              <button class="btn btn-primary btn-sm">Challenge</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  </div>
  <div class="card">
    <h2>Your last duels</h2>
    <% if (!history.length) { %><p class="muted">No duels yet.</p><% } %>
    <table>
      <% history.forEach((d) => {
           const won = (d.result === '1-0' && d.color === 'WHITE') || (d.result === '0-1' && d.color === 'BLACK');
           const kind = d.result === '1/2-1/2' ? 'draw' : won ? 'win' : 'loss'; %>
        <tr>
          <td><span class="badge badge-<%= kind %>"><%= kind.toUpperCase() %></span></td>
          <td>vs <b>@<%= d.opponent %></b><div class="small muted"><%= d.termination.toLowerCase() %> · <%= d.color.toLowerCase() %></div></td>
          <td class="<%= d.rating_change >= 0 ? 'up' : 'down' %>"><%= d.rating_change >= 0 ? '+' : '' %><%= d.rating_change %></td>
          <td><a href="/duels/<%= d.duel_id %>">Scoresheet</a></td>
        </tr>
      <% }) %>
    </table>
  </div>
</div>
<%- include('partials/footer') %>
