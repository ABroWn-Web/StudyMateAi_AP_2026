<%- include('partials/header', { title: 'Log in' }) %>
<div class="card">
  <div class="auth-logo">
    <div class="logo-mark">♞</div>
    <h1>StudyMate AI</h1>
    <p class="muted">Every question is an opponent.</p>
  </div>
  <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.text %></div><% } %>
  <form method="POST" action="/login">
    <label>Email</label>
    <input name="email" type="email" required autofocus>
    <label>Password</label>
    <input name="password" type="password" required>
    <br><br>
    <button class="btn btn-primary btn-block">Log in</button>
  </form>
  <p class="muted small" style="text-align:center">New here? <a href="/signup">Create an account</a></p>
  <div class="demo"><b>Demo account</b><br>user00042@studymate.app · demo1234</div>
</div>
<%- include('partials/footer') %>
