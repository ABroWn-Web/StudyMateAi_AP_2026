<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · StudyMate AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <script>
    // light or dark: remembered choice, otherwise the computer's setting
    try {
      document.documentElement.dataset.theme = localStorage.getItem('theme')
        || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    } catch (e) {}
  </script>
</head>
<body>
<% if (user) { %>
<div class="app">
  <aside class="sidebar">
    <a class="logo" href="/study"><span class="logo-mark">♞</span> StudyMate AI</a>
    <% const groups = [
         ['Study',     [['/study', '✎', 'Workspace'], ['/dashboard', '◧', 'Dashboard']]],
         ['Train',     [['/practice', '♟', 'Practice'], ['/quizzes', '❏', 'Quizzes'], ['/duels', '♞', 'Duels']]],
         ['Review',    [['/notebook', '✓', 'Mistake notebook'], ['/focus', '◷', 'Focus timer']]],
         ['Community', [['/leaderboard', '♛', 'Leaderboard'], ['/coaches', '♗', 'Coaches'], ['/tournaments', '♜', 'Tournaments', 'soon']]],
       ]; %>
    <% groups.forEach(([group, links]) => { %>
      <div class="nav-group"><%= group %></div>
      <% links.forEach(([href, glyph, label, soon]) => {
           const active = path.startsWith(href) || (href === '/quizzes' && path.startsWith('/attempts')); %>
        <a class="nav-link <%= active ? 'active' : '' %>" href="<%= href %>"><span class="glyph"><%= glyph %></span><%= label %><% if (soon) { %><span class="soon">Soon</span><% } %></a>
      <% }) %>
    <% }) %>
    <div class="sidebar-foot">
      <span class="muted">Signed in as <b style="color:var(--ink)">@<%= user.username %></b></span>
      <button class="btn btn-sm" type="button" onclick="toggleTheme()">Light / dark mode</button>
      <form method="POST" action="/logout"><button class="btn btn-sm btn-block">Log out</button></form>
    </div>
  </aside>
  <main class="main">
    <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.text %></div><% } %>
<% } else { %>
  <main class="auth">
<% } %>
