<%- include('partials/header', { title: 'Coaches' }) %>
<div class="page-head">
  <div><h1>Coaches</h1><p class="muted">Top students coach one subject each. You can have one coach per subject.</p></div>
</div>
<%- include('partials/tabs') %>
<% if (myCoaches.length) { %>
  <div class="card" style="margin-bottom:18px">
    <b>Your coaches:</b>
    <% myCoaches.forEach((c) => { %><span class="badge badge-IM" style="margin-left:6px"><%= c.subject_name %>: @<%= c.username %></span><% }) %>
  </div>
<% } %>
<div class="grid grid-3">
  <% coaches.forEach((c) => { %>
    <div class="card">
      <b><% if (c.title_code !== 'CLUB') { %><span class="title-tag"><%= c.title_code %></span><% } %><%= c.full_name %></b>
      <div class="small muted">@<%= c.username %></div>
      <div class="stat-value" style="font-size:28px"><%= c.rating %></div>
      <div class="small muted" style="margin-bottom:12px"><%= c.students %> students</div>
      <% if (c.is_mine) { %>
        <form method="POST" action="/coaches/<%= c.coach_id %>/leave"><button class="btn btn-bad btn-block btn-sm">Leave coach</button></form>
      <% } else { %>
        <form method="POST" action="/coaches/<%= c.coach_id %>/join"><button class="btn btn-primary btn-block btn-sm">Join</button></form>
      <% } %>
    </div>
  <% }) %>
</div>
<%- include('partials/footer') %>
