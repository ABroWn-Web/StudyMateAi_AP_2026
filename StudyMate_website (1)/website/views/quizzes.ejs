<%- include('partials/header', { title: 'Quizzes' }) %>
<div class="page-head">
  <div><h1>Quizzes</h1><p class="muted">10-question quizzes. Every answer updates your rating.</p></div>
</div>
<%- include('partials/tabs') %>

<div class="card hero" style="margin-bottom:18px">
  <div class="page-head" style="margin:0">
    <div>
      <h2 style="margin:0 0 4px">AI quiz generator</h2>
      <p class="muted" style="margin:0">Builds a fresh quiz from the 10 questions closest to your rating (<%= myRating %>).</p>
    </div>
    <form method="POST" action="/quizzes/generate">
      <input type="hidden" name="subject" value="<%= subject %>">
      <button class="btn btn-primary">Generate my quiz</button>
    </form>
  </div>
</div>

<div class="grid grid-3">
  <% quizzes.forEach((q) => { %>
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
        <b><%= q.title %></b>
        <% if (q.is_ai_generated) { %><span class="badge badge-ai">AI</span><% } %>
      </div>
      <p class="small muted"><%= q.questions %> questions · difficulty <%= q.avg_difficulty %></p>
      <form method="POST" action="/quizzes/<%= q.quiz_id %>/start">
        <button class="btn btn-block">Start quiz →</button>
      </form>
    </div>
  <% }) %>
</div>
<%- include('partials/footer') %>
