<%- include('partials/header', { title: 'Duel' }) %>
<div class="card">
  <div class="versus">
    <div class="side"><div class="small muted">♔ White (you)</div><div class="big"><%= duel.mine.username %></div><div><%= duel.mine.rating_before %></div></div>
    <div class="side"><div id="clock" class="clock"
         data-base="<%= duel.mine.base_seconds %>" data-increment="<%= duel.mine.increment_seconds %>">--:--</div>
      <div class="small muted" style="margin-top:6px"><%= duel.mine.base_seconds / 60 %>+<%= duel.mine.increment_seconds %></div></div>
    <div class="side"><div class="small muted">♚ Black</div><div class="big"><%= duel.rival.username %></div><div><%= duel.rival.rating_before %></div></div>
  </div>
</div>

<form id="duel-form" method="POST" action="/duels/<%= duelId %>/finish" style="margin-top:18px">
  <input type="hidden" name="timed_out" value="0">
  <input type="hidden" name="resign" value="0">
  <% questions.forEach((q, i) => { %>
    <div class="card move <%= i === 0 ? '' : 'hidden' %>" data-qid="<%= q.question_id %>">
      <div class="small muted">Move <%= i + 1 %> of <%= questions.length %></div>
      <div class="question"><%= q.question_text %></div>
      <input type="hidden" name="q<%= q.question_id %>" value="">
      <input type="hidden" name="t<%= q.question_id %>" value="0">
      <div class="options">
        <% q.options.forEach((o) => { %>
          <button type="button" class="choice answer" data-option="<%= o.option_no %>"><%= o.option_text %></button>
        <% }) %>
      </div>
    </div>
  <% }) %>
  <p style="text-align:right"><button type="button" id="resign" class="btn btn-bad">Resign</button></p>
</form>
<script src="/duel.js"></script>
<%- include('partials/footer') %>
