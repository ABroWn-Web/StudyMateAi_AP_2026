<%- include('partials/header', { title: attempt.title }) %>
<div class="page-head">
  <div><h1><%= attempt.title %></h1><p class="muted">Answer what you can. Skipped questions count as wrong.</p></div>
</div>
<form method="POST" action="/attempts/<%= attempt.attempt_id %>/submit" class="stack">
  <% questions.forEach((q) => { %>
    <div class="card">
      <div class="small muted">Question <%= q.position %> of <%= questions.length %></div>
      <div class="question"><%= q.question_text %></div>
      <div class="options">
        <% q.options.forEach((o) => { %>
          <label class="option"><input type="radio" name="q<%= q.question_id %>" value="<%= o.option_no %>"><span><%= o.option_text %></span></label>
        <% }) %>
      </div>
    </div>
  <% }) %>
  <button class="btn btn-primary btn-block">Finish quiz</button>
</form>
<%- include('partials/footer') %>
